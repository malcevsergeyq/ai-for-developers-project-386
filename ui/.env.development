# Локальный бэкенд: npm start в корне проекта.
# Пока бэка нет под рукой, можно поднять мок по контракту — npm run mock — и указать
# сюда http://127.0.0.1:4010.
# Адрес именно 127.0.0.1, а не localhost: на Windows localhost резолвится в ::1,
# а сервер слушает IPv4 — запросы уйдут в никуда.
VITE_API_URL=http://127.0.0.1:3000
